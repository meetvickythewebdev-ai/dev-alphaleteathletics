{{ 'vk-carousel-section.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign tab_count = section.blocks | where: 'type', 'tab' | size
-%}

<div
  class="vk-carousel-section vk-category-tabs{% if s.reveal %} vk-reveal{% endif %}"
  style="--vk-pt: {{ s.padding_top }}px; --vk-pb: {{ s.padding_bottom }}px;"
  data-vk-carousel-scope
>
  <div class="vk-container">
    <div class="vk-carousel-section__head">
      {%- if s.heading != blank -%}
        <h2 class="vk-h4 vk-section-heading vk-carousel-section__heading">{{ s.heading }}</h2>
      {%- endif -%}
    </div>

    {%- if tab_count > 1 -%}
      <vk-tabs class="vk-tabs vk-carousel-section__tabs" role="tablist" data-scope="[data-vk-carousel-scope]">
        <span class="vk-tabs__pill" aria-hidden="true"></span>
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'tab' -%}
            <button
              type="button"
              role="tab"
              class="vk-tabs__btn"
              aria-selected="{% if first %}true{% else %}false{% endif %}"
              data-vk-tab="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{ block.settings.label }}
            </button>
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      </vk-tabs>
    {%- endif -%}

    {%- comment -%} Categories belong to the tab block that precedes them. {%- endcomment -%}
    {%- assign panel_open = false -%}
    {%- assign panel_index = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'tab' -%}
        {%- if panel_open -%}
              </div>
            </vk-carousel>
          </div>
        {%- endif -%}
        <div class="vk-carousel-section__panel{% if panel_index == 0 %} is-active{% endif %}" data-vk-panel="{{ block.id }}" {% if panel_index > 0 %}hidden{% endif %}>
          <vk-carousel
            class="swiper vk-carousel-section__swiper"
            data-options='{"slidesPerView": {{ s.per_view_mobile }}, "spaceBetween": 12, "breakpoints": {"750": {"slidesPerView": {{ s.per_view_desktop }}}}}'
          >
            <div class="swiper-wrapper">
        {%- assign panel_open = true -%}
        {%- assign panel_index = panel_index | plus: 1 -%}
      {%- elsif block.type == 'category' and panel_open -%}
              <div class="swiper-slide" {{ block.shopify_attributes }}>
                <a href="{{ block.settings.link }}" class="vk-cat-card">
                  <div class="vk-cat-card__media">
                    {%- if block.settings.image != blank -%}
                      {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '300, 450, 600, 800, 1000, 1200', sizes: '(min-width: 750px) 20vw, 45vw', loading: 'lazy', alt: block.settings.title, class: 'vk-cat-card__img' }}
                    {%- elsif block.settings.collection.featured_image -%}
                      {{ block.settings.collection.featured_image | image_url: width: 1200 | image_tag: widths: '300, 450, 600, 800, 1000, 1200', sizes: '(min-width: 750px) 20vw, 45vw', loading: 'lazy', alt: block.settings.title, class: 'vk-cat-card__img' }}
                    {%- else -%}
                      {{ 'collection-apparel-1' | placeholder_svg_tag: 'vk-cat-card__img vk-cat-card__placeholder' }}
                    {%- endif -%}
                  </div>
                  <div class="vk-cat-card__content">
                    <h3 class="vk-cat-card__title"><span>{{ block.settings.title }}</span></h3>
                    {%- if block.settings.text != blank -%}
                      <div class="vk-cat-card__text">{{ block.settings.text }}</div>
                    {%- endif -%}
                  </div>
                </a>
              </div>
      {%- endif -%}
    {%- endfor -%}
    {%- if panel_open -%}
            </div>
          </vk-carousel>
        </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "VK Category tabs",
  "tag": "section",
  "class": "vk-section vk-section-category-tabs",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<strong>POPULAR CATEGORIES</strong>" },
    { "type": "range", "id": "per_view_mobile", "label": "Cards per view (mobile)", "min": 1, "max": 3, "step": 0.1, "default": 2.3 },
    { "type": "range", "id": "per_view_desktop", "label": "Cards per view (tablet & desktop)", "min": 3, "max": 7, "step": 0.1, "default": 5 },
    { "type": "checkbox", "id": "reveal", "label": "Fade in on scroll", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Women's" },
        { "type": "paragraph", "content": "Category blocks placed below this tab appear in it." }
      ]
    },
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "collection", "id": "collection", "label": "Collection (image fallback)" },
        { "type": "text", "id": "title", "label": "Title", "default": "BRAS" },
        { "type": "text", "id": "text", "label": "Subtitle", "default": "Locked in and lifted." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "VK Category tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Women's" } },
        { "type": "category" }, { "type": "category" }, { "type": "category" },
        { "type": "tab", "settings": { "label": "Men's" } },
        { "type": "category" }, { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
