{%- comment -%}
  vk-predictive-search: rendered by /search/suggest?section_id=vk-predictive-search for the header search drawer.
  Results use the same product card as the rest of the store (reference behaviour).
{%- endcomment -%}
<div id="vk-predictive-search">
  {%- if predictive_search.performed -%}
    {%- assign products = predictive_search.resources.products -%}
    <div class="vk-search__results">
      {%- if products.size > 0 -%}
        <div class="vk-search__col vk-search__col--products">
          <h6 class="vk-search__label">{{ 'templates.search.products' | t }}</h6>
          <div class="vk-search__grid">
            {%- for product in products -%}
              {% render 'vk-product-card', product: product, sizes: '(min-width: 990px) 15vw, (min-width: 750px) 30vw, 45vw' %}
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <div class="vk-search__col">
          <p class="vk-search__empty">{{ 'templates.search.no_results' | t: terms: predictive_search.terms }}</p>
        </div>
      {%- endif -%}
      <div class="vk-search__col vk-search__col--footer">
        <button type="submit" class="vk-reset-btn vk-btn-text vk-search__all">
          {{ 'templates.search.search_for' | t: terms: predictive_search.terms }}
        </button>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{ "name": "VK Predictive search", "class": "vk-section" }
{% endschema %}
