{{ 'vk-athlete-edit.css' | asset_url | stylesheet_tag }}
<script src="{{ 'vk-athlete-edit.js' | asset_url }}" defer="defer"></script>

{%- assign s = section.settings -%}

<vk-athlete-edit
  class="vk-ae{% if s.reveal %} vk-reveal{% endif %}"
  style="--vk-pt: {{ s.padding_top }}px; --vk-pb: {{ s.padding_bottom }}px; --vk-pt-m: {{ s.padding_top_mobile }}px; --vk-pb-m: {{ s.padding_bottom_mobile }}px; --vk-ae-cols: {{ s.columns }};"
  data-section-id="{{ section.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-label-select="{{ 'vk.select_size' | t | escape }}"
>
  <div class="vk-container">
    <div class="vk-ae__header">
      {%- if s.heading != blank -%}
        <h2 class="vk-h4 vk-section-heading vk-ae__heading">{{ s.heading }}</h2>
      {%- endif -%}
      <div class="vk-arrows vk-ae__nav">
        <button type="button" class="vk-reset-btn vk-arrow vk-arrow--prev" data-ae-prev aria-label="{{ 'vk.previous' | t }}">{% render 'vk-icon', icon: 'chevron-right' %}</button>
        <button type="button" class="vk-reset-btn vk-arrow" data-ae-next aria-label="{{ 'vk.next' | t }}">{% render 'vk-icon', icon: 'chevron-right' %}</button>
      </div>
    </div>

    <ul class="vk-list-reset vk-ae__track" data-ae-track>
      {%- for block in section.blocks -%}
        <li class="vk-ae__card" data-ae-card="{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="vk-ae__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1100 | image_tag: widths: '400, 600, 800, 1100', sizes: '(min-width: 990px) 24vw, (min-width: 750px) 42vw, 78vw', loading: 'lazy', alt: block.settings.handle, class: 'vk-ae__img' }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'vk-ae__img vk-ae__placeholder' }}
            {%- endif -%}
          </div>
          {%- if block.settings.handle != blank -%}
            <span class="vk-ae__handle">{{ block.settings.handle }}</span>
          {%- endif -%}
          {%- if block.settings.products.size > 0 -%}
            <div class="vk-ae__footer">
              <button type="button" class="vk-reset-btn vk-ae__cta" data-ae-open="{{ block.id }}">{{ block.settings.cta_label }}</button>
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>

  <div class="vk-ae-drawer" data-ae-drawer data-section-id="{{ section.id }}" aria-hidden="true">
    <div class="vk-ae-drawer__overlay" data-ae-close></div>
    <div class="vk-ae-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ s.drawer_title | escape }}" tabindex="-1" data-ae-panel>
      {%- for block in section.blocks -%}
        <div class="vk-ae-drawer__look" data-ae-look="{{ block.id }}" hidden>
          <div class="vk-ae-drawer__header">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', class: 'vk-ae-drawer__thumb', width: 44, height: 56 }}
            {%- endif -%}
            <div class="vk-ae-drawer__heading">
              <p class="vk-ae-drawer__title">{{ s.drawer_title }}</p>
              {%- if block.settings.handle != blank -%}
                <p class="vk-ae-drawer__subtitle">{{ s.worn_by_label }} {{ block.settings.handle | downcase }}</p>
              {%- endif -%}
            </div>
            <button type="button" class="vk-reset-btn vk-ae-drawer__close" data-ae-close aria-label="{{ 'accessibility.close' | t }}">{% render 'vk-icon', icon: 'close' %}</button>
          </div>

          <ul class="vk-list-reset vk-ae-drawer__items">
            {%- for product in block.settings.products -%}
              {%- liquid
                assign base_title = product.title | split: ' - ' | first
                assign color_name = ''
                if product.title contains ' - '
                  assign color_name = product.title | split: ' - ' | last
                endif
                assign single = product.has_only_default_variant
              -%}
              <li class="vk-ae-drawer__item" data-ae-item data-price="{{ product.price }}" {% if single %}data-variant="{{ product.selected_or_first_available_variant.id }}"{% endif %}>
                <a href="{{ product.url }}" class="vk-ae-drawer__item-media">
                  {%- if product.featured_media -%}
                    {{ product.featured_media | image_url: width: 240 | image_tag: loading: 'lazy', alt: product.title, width: 96, height: 120 }}
                  {%- endif -%}
                </a>
                <div class="vk-ae-drawer__item-body">
                  <div class="vk-ae-drawer__item-top">
                    <div>
                      <a href="{{ product.url }}" class="vk-ae-drawer__item-title">{{ base_title }}</a>
                      {%- if color_name != blank -%}<p class="vk-ae-drawer__item-color">{{ color_name }}</p>{%- endif -%}
                      <p class="vk-ae-drawer__item-price">{{ product.price | money }}</p>
                    </div>
                    <label class="vk-ae-drawer__include">
                      <input type="checkbox" checked data-ae-include>
                      <span>{{ s.include_label }}</span>
                    </label>
                  </div>
                  {%- unless single -%}
                    <div class="vk-ae-drawer__sizes" role="radiogroup" aria-label="{{ 'vk.select_size' | t | escape }}">
                      {%- for variant in product.variants -%}
                        <button
                          type="button"
                          class="vk-reset-btn vk-ae-drawer__size{% unless variant.available %} is-unavailable{% endunless %}"
                          role="radio"
                          aria-checked="false"
                          data-variant="{{ variant.id }}"
                          {% unless variant.available %}disabled{% endunless %}
                        >{{ variant.title }}</button>
                      {%- endfor -%}
                    </div>
                  {%- endunless -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <div class="vk-ae-drawer__footer">
        <div class="vk-ae-drawer__summary">
          <span class="vk-ae-drawer__caption" data-ae-caption data-template="{{ s.total_label | escape }}"></span>
          <span class="vk-ae-drawer__total" data-ae-total></span>
        </div>
        <button
          type="button"
          class="vk-reset-btn vk-ae-drawer__submit"
          data-ae-submit
          data-label-select="{{ s.select_label | escape }}"
          data-label-add="{{ s.add_label | escape }}"
          data-label-none="{{ s.none_label | escape }}"
          disabled
        ></button>
        <p class="vk-ae-drawer__message" data-ae-message role="status" hidden></p>
      </div>
    </div>
  </div>
</vk-athlete-edit>

{% schema %}
{
  "name": "VK Athlete edit",
  "tag": "section",
  "class": "vk-section vk-section-athlete-edit",
  "max_blocks": 16,
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "<strong>THE ATHLETE EDIT</strong>" },
    { "type": "range", "id": "columns", "label": "Cards per view (tablet & desktop)", "info": "A slice of the next card is always shown. Mobile shows 1.3 cards.", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "reveal", "label": "Fade in on scroll", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top padding (desktop)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding (desktop)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 24 },
    { "type": "header", "content": "Shop the look drawer" },
    { "type": "text", "id": "drawer_title", "label": "Title", "default": "Shop the look" },
    { "type": "text", "id": "worn_by_label", "label": "Worn by prefix", "default": "As worn by" },
    { "type": "text", "id": "include_label", "label": "Include label", "default": "Include" },
    { "type": "text", "id": "total_label", "label": "Total caption", "default": "Look total · [selected] of [count] items", "info": "[selected] and [count] are replaced automatically." },
    { "type": "text", "id": "select_label", "label": "Button when sizes are missing", "default": "Select a size for [n] items" },
    { "type": "text", "id": "add_label", "label": "Add button", "default": "Add [n] items to cart" },
    { "type": "text", "id": "none_label", "label": "Button when nothing is included", "default": "Select at least one item" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "handle", "label": "Athlete handle", "default": "@athlete" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop the look" },
        { "type": "product_list", "id": "products", "label": "Products in the look", "limit": 6 }
      ]
    }
  ],
  "presets": [
    { "name": "VK Athlete edit", "blocks": [ { "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" }, { "type": "look" } ] }
  ]
}
{% endschema %}
