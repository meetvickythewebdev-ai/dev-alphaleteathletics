{%- comment -%}
  vk-social-icons: social links from theme settings. Params: class (optional)
{%- endcomment -%}
{%- liquid
  assign socials = 'instagram,facebook,youtube,tiktok,twitter' | split: ','
-%}
<ul class="vk-list-reset vk-social {{ class }}">
  {%- for s in socials -%}
    {%- assign key = 'social_' | append: s | append: '_link' -%}
    {%- assign url = settings[key] -%}
    {%- if url != blank -%}
      <li>
        <a href="{{ url }}" class="vk-social__link" target="_blank" rel="noopener" aria-label="{{ s | capitalize }}">
          {%- case s -%}
            {%- when 'instagram' -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="1em" height="1em" fill="none"><rect x="3.75" y="3.75" width="16.5" height="16.5" rx="4.5" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="3.75" stroke="currentColor" stroke-width="1.5"/><circle cx="17.25" cy="6.75" r="1" fill="currentColor"/></svg>
            {%- when 'facebook' -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12c0 4.99 3.66 9.13 8.44 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99C18.34 21.13 22 16.99 22 12c0-5.52-4.48-10-10-10Z"/></svg>
            {%- when 'youtube' -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M21.58 7.19a2.5 2.5 0 0 0-1.76-1.77C18.25 5 12 5 12 5s-6.25 0-7.82.42A2.5 2.5 0 0 0 2.42 7.19 26.1 26.1 0 0 0 2 12a26.1 26.1 0 0 0 .42 4.81 2.5 2.5 0 0 0 1.76 1.77C5.75 19 12 19 12 19s6.25 0 7.82-.42a2.5 2.5 0 0 0 1.76-1.77A26.1 26.1 0 0 0 22 12a26.1 26.1 0 0 0-.42-4.81ZM10 15V9l5.2 3L10 15Z"/></svg>
            {%- when 'tiktok' -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.6 2.6 0 0 1-2.6-2.6 2.6 2.6 0 0 1 3.35-2.49V9.66a5.69 5.69 0 0 0-.75-.05A5.73 5.73 0 0 0 4.13 15.3 5.73 5.73 0 0 0 9.86 21a5.73 5.73 0 0 0 5.73-5.7V9.01a7.35 7.35 0 0 0 4.29 1.38V7.3a4.28 4.28 0 0 1-3.28-1.48Z"/></svg>
            {%- when 'twitter' -%}<svg aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor"><path d="M17.75 3h3.07l-6.71 7.67L22 21h-6.18l-4.84-6.33L5.44 21H2.37l7.18-8.2L2 3h6.34l4.37 5.78L17.75 3Zm-1.08 16.18h1.7L7.4 4.73H5.58l11.09 14.45Z"/></svg>
          {%- endcase -%}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>
